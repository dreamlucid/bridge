{
    "ignorePatterns": [
        "**/*.test.js",
        "**/node_modules/**/*.js",
        "/bin/**/*.js",
        "/dist/**/*.js"
    ],
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "extends": [
        "standard"
    ],
    "overrides": [
        {
            "files": ["**/*.jsx"],
            "parser": "@babel/eslint-parser",
            "parserOptions": {
                "ecmaVersion": "latest",
                "sourceType": "module",
                "ecmaFeatures": {
                    "jsx": true
                },
                "requireConfigFile": false,
                "babelOptions": {
                    "presets": ["@babel/preset-react"]
                }
            },
            "plugins": ["react"],
            "extends": [
                "standard",
                "plugin:react/recommended"
            ],
            "settings": {
                "react": {
                    "version": "detect"
                }
            },
            "rules": {
                "react/prop-types": "off"
            }
        }
    ],
    "parserOptions": {
        "ecmaVersion": "latest"
    },
    "plugins": [
    ],
    "rules": {
    }
}
